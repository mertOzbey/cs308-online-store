generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SALES_MANAGER
  PRODUCT_MANAGER
  SUPPORT_AGENT
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  taxId        String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  homeAddress  String   @db.VarChar(1000)
  passwordHash String   @db.VarChar(512)
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AuthSession[]
  orders       Order[]
  ratings      Rating[]
  comments     Comment[]
}

model AuthSession {
  tokenHash String    @id @db.Char(64)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                     Int      @id @default(autoincrement())
  name                   String
  model                  String
  serialNumber           String   @unique
  description            String
  stockQuantity          Int      @default(0)
  /// Units sold so far; GET /api/products?sort=popularity orders by this (SCRUM-81).
  salesCount             Int      @default(0)
  price                  Decimal  @db.Decimal(12, 2)
  warrantyStatus         String
  distributorInformation String
  categoryId             Int
  category               Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  orderItems OrderItem[]
  ratings    Rating[]
  comments   Comment[]

  @@index([categoryId])
}

enum OrderStatus {
  processing
  in_transit @map("in-transit")
  delivered
}

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int
  customer        User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  idempotencyKey  String      @db.Uuid
  invoiceNumber   String      @unique
  customerName    String      @db.VarChar(200)
  customerEmail   String      @db.VarChar(254)
  deliveryAddress String      @db.VarChar(1000)
  purchasedAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  status          OrderStatus @default(processing)
  currency        String      @default("TRY") @db.VarChar(3)
  total           Decimal     @db.Decimal(24, 2)
  items           OrderItem[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, purchasedAt(sort: Desc), id(sort: Desc)])
}

model OrderItem {
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(24, 2)

  @@id([orderId, productId])
  @@index([productId])
}

enum CommentStatus {
  pending
  approved
  rejected
}

model Rating {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  /// The database enforces the inclusive range 1–5.
  value      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId])
  @@index([productId])
}

model Comment {
  id         Int           @id @default(autoincrement())
  customerId Int
  productId  Int
  text       String
  status     CommentStatus @default(pending)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  customer   User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@index([status, createdAt])
}
