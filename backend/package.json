{
  "name": "cs308-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
