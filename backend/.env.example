# Local development only. Keep actual connection credentials in the ignored .env file.
DATABASE_URL="postgresql://cs308:local_dev_only@localhost:5432/cs308?schema=public"
# Tests create and remove their own schema inside this separate database.
TEST_DATABASE_URL="postgresql://cs308:local_dev_only@localhost:5432/cs308_test?schema=public"

# Authentication: serve frontend and /api through the same origin/proxy.
# Set NODE_ENV=production and APP_ORIGIN to the canonical HTTPS frontend origin in production.
APP_ORIGIN="http://localhost:5173"
# Optional additional trusted canonical origins, comma separated; never use '*'.
# AUTH_ALLOWED_ORIGINS="http://127.0.0.1:5173"
SESSION_COOKIE_NAME="sulina_session"
# 8 hours; integer between 60 seconds and 30 days. Production always enables Secure cookies.
SESSION_TTL_SECONDS="28800"
