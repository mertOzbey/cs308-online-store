generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SALES_MANAGER
  PRODUCT_MANAGER
  SUPPORT_AGENT
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  taxId        String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  homeAddress  String   @db.VarChar(1000)
  passwordHash String   @db.VarChar(512)
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AuthSession[]
}

model AuthSession {
  tokenHash String    @id @db.Char(64)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                     Int      @id @default(autoincrement())
  name                   String
  model                  String
  serialNumber           String   @unique
  description            String
  stockQuantity          Int      @default(0)
  /// Units sold so far; GET /api/products?sort=popularity orders by this (SCRUM-81).
  salesCount             Int      @default(0)
  price                  Decimal  @db.Decimal(12, 2)
  warrantyStatus         String
  distributorInformation String
  categoryId             Int
  category               Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([categoryId])
}
