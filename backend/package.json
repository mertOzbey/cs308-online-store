    "db:check": "node scripts/check-database.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "cookie": "2.0.2",
    "dotenv": "17.4.2",
    "express": "^5.3.0",
    "pdfkit": "0.21.0"
  },
  "devDependencies": {
    "pdfjs-dist": "6.5.438",
    "prisma": "7.10.1"
  }
}
